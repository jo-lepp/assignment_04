{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Runs the open file as a plain Python script — use this for
            // code/packaging.py, whose `if __name__ == '__main__':` block is a
            // handy place to try the parser in the debugger.
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            // Runs the open file as a Streamlit app on port 28502 — the same as
            // typing `streamlit run code/one_package.py` in a terminal, except
            // that breakpoints work. See README Reference #1.
            "name": "Streamlit Run: Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "env": {
                "STREAMLIT_SERVER_PORT": "28502"
            },
            "args": ["run", "${file}"],
            "console": "integratedTerminal"
        },
        {
            "name": "FastAPI: Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${fileDirname}",
            "args": ["${fileBasenameNoExtension}:app", "--host", "0.0.0.0", "--port", "28000"],
            "console": "integratedTerminal"
        }
    ]
}
